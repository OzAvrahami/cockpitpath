{
  "name": "cockpitpath",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "node --env-file=.env.local scripts/run-db-migration.cjs up",
    "db:migrate:create": "node ./node_modules/node-pg-migrate/bin/node-pg-migrate.js create --migrations-dir migrations --migration-file-language sql",
    "db:migrate:down": "node --env-file=.env.local scripts/run-db-migration.cjs down",
    "db:test": "node --env-file=.env.local scripts/db-test.cjs",
    "content:validate": "node scripts/content/cli.cjs validate content",
    "content:publish:dry-run": "node --env-file=.env.local scripts/content/cli.cjs publish content --dry-run",
    "content:publish": "node --env-file=.env.local scripts/content/cli.cjs publish content",
    "content:test:integration": "node --env-file=.env.local scripts/content/publish-integration-test.cjs"
  },
  "dependencies": {
    "@neondatabase/auth": "0.5.0-beta",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "vitest": "^4.1.11",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
