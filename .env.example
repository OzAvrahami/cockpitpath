NEON_AUTH_BASE_URL=https://your-development-auth-endpoint.example
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL_UNPOOLED=postgresql://development-owner:password@development-host.example/database?sslmode=require
NEON_BRANCH=development
NEON_DATA_API_URL=https://your-development-data-api.example/rest/v1
CONTENT_DATABASE_URL=postgresql://development-content-reader:password@development-host.example/database?sslmode=require

# Railway staging web uses staging-only Auth, Data API, and content-reader values.
# Keep DATABASE_URL_UNPOOLED outside the running Railway web service.
